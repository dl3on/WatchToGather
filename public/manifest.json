{
  "manifest_version": 3,
  "name": "WatchToGather",
  "version": "1.0.0",
  "description": "P2P watch party extension",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "32": "icons/watchtogather_icon_32.png",
      "48": "icons/watchtogather_icon_48.png",
      "128": "icons/watchtogather_icon_128.png"
    }
  },
  "icons": {
    "128": "icons/watchtogather_icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content/main.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "offscreen",
    "webNavigation",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://signal.coronne.io/*",
    "ws://signal.coronne.io/*",
    "<all_urls>"
  ]
}
